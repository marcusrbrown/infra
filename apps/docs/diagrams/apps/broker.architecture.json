      "size": [150, 60]
    }
  ],
  "boundaries": [
    {
      "kind": "security-group",
      "label": "Droplet, Compose stack",
      "wraps": ["caddy", "oidc", "policy", "mint", "live", "sweeper"],
      "pad": 20
    }
  ],
  "connections": [
    {"id": "mint-request", "from": "runner", "to": "caddy", "label": "POST /v1/mint", "variant": "emphasis"},
    {"id": "forward", "from": "caddy", "to": "oidc", "label": "forward", "variant": "emphasis"},
    {"id": "claims", "from": "oidc", "to": "policy", "label": "claims", "variant": "security"},
    {"id": "allowed", "from": "policy", "to": "mint", "label": "allowed", "variant": "emphasis"},
    {"id": "record", "from": "mint", "to": "live", "label": "record"},
    {"id": "expire", "from": "sweeper", "to": "live", "label": "expire"},
    {"id": "mint-key", "from": "mint", "to": "cliproxy", "label": "add key", "variant": "security"},
    {"id": "revoke-key", "from": "sweeper", "to": "cliproxy", "label": "revoke", "variant": "security"}
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Mint",
      "items": [
        "Verify the OIDC token, then check its claims against the code-owned policy",
        "Mint a ghact- key through the proxy management API with read-back",
        "Return the OpenCode auth payload"
      ]
    },
    {
      "dot": "rose",
      "title": "Revoke",
      "items": [
        "There is no run-end revoke; the sweeper is the mandatory backstop",
        "Reconcile revokes only expired ghact- keys and never touches other keys",
        "The broker is single-instance: its lock is valid only because there is one"
      ]
    }
  ]
}
