      "pos": [580, 360],
      "size": [150, 60]
    },
    {
      "id": "sweeper",
      "type": "backend",
      "label": "Sweeper",
      "sublabel": "60 s tick, 5 min reconcile",
      "pos": [580, 520],
      "size": [150, 60]
    },
    {
      "id": "cliproxy",
      "type": "external",
      "label": "CLIProxyAPI",
      "sublabel": "management API",
