  "cards": [
    {
      "dot": "cyan",
      "title": "Stack",
      "items": [
        "Images are built in CI and pulled by digest; the droplet never builds",
        "A Caddy service joins the stack only when announce or the operator listener is on"
      ]
    },
    {
      "dot": "rose",
      "title": "Isolation",
      "items": [
        "The workspace sits on its own sandbox network with no host ports",
        "All workspace egress goes through mitmproxy, which fails closed on an empty allowlist",
        "The operator listener is published only on the private VPC address, restricted to the dashboard host"
      ]
    }
  ]
