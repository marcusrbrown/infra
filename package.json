{
  "name": "@marcusrbrown/infra-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepare": "simple-git-hooks",
    "test": "bun test --recursive",
    "version-changesets": "changeset version"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yaml,yml,conf}": [
      "eslint --fix"
    ]
  },
  "prettier": "@bfra.me/prettier-config/120-proof",
  "dependencies": {
    "goke": "^6.8.0"
  },
  "devDependencies": {
    "@bfra.me/eslint-config": "0.51.1",
    "@bfra.me/prettier-config": "^0.16.0",
    "@bfra.me/tsconfig": "^0.13.0",
    "@changesets/cli": "^2.30.0",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@types/bun": "^1.3.11",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.2",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^6.0.0"
  }
}
