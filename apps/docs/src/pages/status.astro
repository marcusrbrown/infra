---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import {APP_IDS} from '@marcusrbrown/infra-shared/status/history-schema'

import StatusNotes from '../components/StatusNotes.astro'
import {SERVICES} from '../data/services'
import {
  formatUtc,
  PROOF_KINDS,
  PROOF_LABELS,
  RESULT_DISPLAY,
  STALE_THRESHOLD_MS,
  VERDICT_DISPLAY,
} from '../lib/history-view'
import {loadStatusData} from '../lib/status-data'

const {source, meta, views} = loadStatusData()
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const staleMinutes = STALE_THRESHOLD_MS / 60_000
---

<StarlightPage
  frontmatter={{
    title: 'Status',
    description: 'Latest public observations for each monitored app, labeled by what they prove.',
    tableOfContents: false,
  }}
>
  <p>
    Last sample <time id="status-generated" datetime={meta.lastSampleAt} data-stale-minutes={staleMinutes}
      >{formatUtc(meta.lastSampleAt)}</time
    ><span id="status-age"></span>.
  </p>
  <p id="status-stale" hidden>
    ⚠️ The newest sample is more than {staleMinutes} minutes old. The snapshot may have stopped, so these results can be out of
    date.
  </p>

  <StatusNotes fixture={source === 'fixture'} />

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">App</th>
          {PROOF_KINDS.map(kind => <th scope="col">{PROOF_LABELS[kind]}</th>)}
          <th scope="col">Summary</th>
        </tr>
      </thead>
      <tbody>
        {
          APP_IDS.map(app => {
            const view = views[app]
            const verdict = VERDICT_DISPLAY[view.verdict]
            return (
              <tr>
                <th scope="row">
                  <a href={`${base}services/${app}/`}>{SERVICES[app].title}</a>
                </th>
                {PROOF_KINDS.map(kind => {
                  const cell = view.cells[kind]
                  return (
                    <td>
                      {RESULT_DISPLAY[cell.result].symbol} {RESULT_DISPLAY[cell.result].word}
                      {cell.note !== undefined && <> ({cell.note})</>}
                    </td>
                  )
                })}
                <td>
                  {verdict.symbol} {verdict.word}: {view.verdictLabel}
                </td>
              </tr>
            )
          })
        }
      </tbody>
    </table>
  </div>

  <p>
    Legend: ✅ pass, ❌ fail, ❓ unknown (the check could not decide), ⚪ not measured (nothing in the public snapshot checks
    it). Each app's service page has its sample counts, coverage and gaps.
  </p>

  <script is:inline>
    ;(function () {
      var el = document.getElementById('status-generated')
      if (!el) return
      var then = Date.parse(el.getAttribute('datetime') || '')
      if (isNaN(then)) return
      var limit = Number(el.getAttribute('data-stale-minutes')) * 60000
      var minutes = Math.max(0, Math.round((Date.now() - then) / 60000))
      var age = document.getElementById('status-age')
      if (age) {
        age.textContent =
          minutes < 60
            ? ' (' + minutes + ' min ago)'
            : minutes < 2880
              ? ' (' + Math.round(minutes / 60) + ' h ago)'
              : ' (' + Math.round(minutes / 1440) + ' days ago)'
      }
      if (Date.now() - then > limit) {
        var warn = document.getElementById('status-stale')
        if (warn) warn.hidden = false
      }
    })()
  </script>
</StarlightPage>

<style>
  .table-scroll {
    overflow-x: auto;
  }
</style>
