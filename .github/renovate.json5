{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>marcusrbrown/renovate-config#5.2.17'],
  packageRules: [
    {
      description: ['Vendored agent skills are updated by their installer (skills-lock.json), not Renovate'],
      matchFileNames: ['.agents/skills/**'],
      enabled: false,
    },
    {
      description: ['Disable digest updates for bfra-me GitHub Actions'],
      matchManagers: ['github-actions'],
      matchPackageNames: ['bfra-me/.github'],
      matchUpdateTypes: ['digest'],
      enabled: false,
    },
    {
      description: ['Add changelog context for CLIProxyAPI Docker digest updates'],
      matchDatasources: ['docker'],
      matchPackageNames: ['eceasy/cli-proxy-api'],
      sourceUrl: 'https://github.com/router-for-me/CLIProxyAPI',
      changelogUrl: 'https://github.com/router-for-me/CLIProxyAPI/releases',
      groupName: null,
    },
    {
      description: ['Add changelog context for Caddy Docker image updates'],
      matchDatasources: ['docker'],
      matchPackageNames: ['caddy'],
      sourceUrl: 'https://github.com/caddyserver/caddy',
      changelogUrl: 'https://github.com/caddyserver/caddy/releases',
      groupName: null,
      // Each bump stays gated pending a check that the new tag has a linux/amd64 manifest.
      // 2.11.6 cuts idle streaming responses (operator SSE) after 60s; fixed in 2.11.7.
      allowedVersions: '/^2\\.11\\.([0-57-9]|[0-9]{2,})(-|$)/',
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // The SDK releases almost daily, and each bump queues gated gateway and VPN deploys. Nothing here
      // needs every release, so a bump waits for a dashboard checkbox and is taken in batches.
      description: ['Require dashboard approval for AWS SDK updates'],
      matchDatasources: ['npm'],
      matchPackageNames: ['@aws-sdk/**'],
      dependencyDashboardApproval: true,
    },
    {
      description: ['Add changelog context for Umami Docker image updates'],
      matchDatasources: ['docker'],
      matchPackageNames: ['umamisoftware/umami'],
      sourceUrl: 'https://github.com/umami-software/umami',
      changelogUrl: 'https://github.com/umami-software/umami/releases',
      groupName: null,
    },
    {
      matchDatasources: ['npm'],
      matchPackageNames: ['typescript'],
      // @typescript-eslint/* peers require typescript >=4.8.4 <6.1.0; lift this ceiling when
      // TypeScript 7 support lands upstream in typescript-eslint#10940.
      allowedVersions: '<7',
    },
    {
      // ghcr.io/fro-bot/dashboard is the upstream-published, smoke-tested image consumed by
      // apps/dashboard via docker-compose.yaml (tag@digest pin). The implicit docker-compose
      // manager tracks digest bumps; this rule adds PR context and requires operator approval
      // before a bump PR is created — matching the cliproxy/umami gating pattern.
      description: ['Add changelog context for fro-bot/dashboard Docker image updates'],
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/fro-bot/dashboard'],
      sourceUrl: 'https://github.com/fro-bot/dashboard',
      changelogUrl: 'https://github.com/fro-bot/dashboard/releases',
      groupName: null,
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      description: ['Add changelog context for Postgres Docker image updates'],
      matchDatasources: ['docker'],
      matchPackageNames: ['postgres'],
      sourceUrl: 'https://github.com/postgres/postgres',
      changelogUrl: 'https://www.postgresql.org/docs/release/',
      groupName: null,
      // A Postgres major bump cannot be applied by recreating the container — a new major
      // refuses to start against the previous major's data directory, and the password is baked
      // into the named volume. Cap versions at <19 and require explicit dashboard
      // approval so the next major can never auto-PR/auto-merge/auto-deploy ahead of a migration
      // runbook (docs/runbooks/umami-postgres-major-upgrade.md). Raise the ceiling only as part
      // of an executed cutover.
      allowedVersions: '<19',
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // The github-releases datasource auto-derives source URL + release notes from depName
      // (= the GitHub repo), so no sourceUrl/changelogUrl needed. This rule exists ONLY to keep
      // each release a standalone PR (each fro-bot/agent bump = a gateway daemon rebuild+redeploy)
      // instead of being grouped into group:allNonMajor.
      description: ['Keep fro-bot/agent upstream.json releases as standalone PRs'],
      matchDatasources: ['github-releases'],
      matchPackageNames: ['fro-bot/agent'],
      groupName: null,
      // The fro-bot/agent GitHub Action pin (github-tags datasource) shares this depName and
      // would otherwise land on the same branch, so the approval gate below would hold it too.
      // A distinct branch (renovate/gateway-fro-bot-agent-0.x) and commit topic keep them apart.
      additionalBranchPrefix: 'gateway-',
      commitMessageTopic: 'Fro Bot gateway daemon (fro-bot/agent)',
      // Each fro-bot/agent bump rebuilds and redeploys the executable gateway daemon, so it must
      // not inherit the fro-bot/** minor+patch automerge from the shared preset. Require explicit
      // operator approval (dashboard checkbox to create the PR, manual merge) so every daemon bump
      // gets a source-contract verification pass before landing — verify no new boot-required
      // config before the ceiling moves.
      automerge: false,
      dependencyDashboardApproval: true,
      allowedVersions: '<0.149.0',
    },
    {
      // The traces collector is built from apps/traces/collector/builder-config.yaml: the collector
      // core, the contrib components and Elastic's ratelimit processor are separate Go modules that
      // must move as one set, and the builder in the Dockerfile must match the core. One group puts
      // them on one branch, so a bump can never move the core without the limiter or the reverse.
      // Approval-gated and never automerged: a new set is rebuilt and checked before it ships, and
      // the Elastic processor's required core version is read from its go.mod when the PR is reviewed.
      // matchManagers keeps the stack's other image pins (Dockerfile FROM lines, compose files) out of
      // this group; those have their own rules.
      description: ['Group the traces collector core, contrib components, Elastic ratelimit processor and builder'],
      matchManagers: ['custom.regex'],
      matchFileNames: ['apps/traces/collector/**'],
      groupName: 'traces collector',
      groupSlug: 'traces-collector',
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // The trace stack's stateful images hold trace content on a volume. A new version can migrate or
      // rewrite that data in place, and the way back is a roll-forward or a volume snapshot, so no bump
      // lands unattended: each needs a dashboard checkbox to open the PR and a manual merge. Caddy is not
      // listed: the Caddy rule above already gates it, and Grafana and the Bun runtime image follow the
      // default rules. The collector's Dockerfile base images are handled by the rule after the next one.
      description: ['Require dashboard approval and never automerge the trace stack stateful images'],
      matchFileNames: ['apps/traces/docker-compose.yaml'],
      matchPackageNames: [
        'cgr.dev/chainguard/minio',
        'clickhouse/clickhouse-server',
        'grafana/tempo',
        'postgres',
        'redis',
      ],
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // Langfuse web and worker must run the same version: the worker consumes what web enqueues, and a
      // release can change the queue and ClickHouse schema. One group puts both pins on one branch, so a
      // bump can never move one without the other.
      description: ['Group Langfuse web and worker, with dashboard approval and no automerge'],
      matchFileNames: ['apps/traces/docker-compose.yaml'],
      matchPackageNames: ['docker.langfuse.com/langfuse/langfuse', 'docker.langfuse.com/langfuse/langfuse-worker'],
      groupName: 'langfuse',
      groupSlug: 'langfuse',
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // The trace stack's PostgreSQL is held at its current major, like Umami's, for the same reason: a new
      // major refuses to start against the previous major's data directory. Raise the ceiling only as part
      // of an executed upgrade. This rule follows the Postgres rule above, so its ceiling wins for this file.
      description: ['Hold the trace stack PostgreSQL at major 17'],
      matchFileNames: ['apps/traces/docker-compose.yaml'],
      matchPackageNames: ['postgres'],
      allowedVersions: '<18',
    },
    {
      // ClickHouse holds Langfuse's trace data and the 30-day TTLs the deploy sets. It stays on the 26.3 LTS
      // line that Langfuse pins upstream, on its own branch so it never rides along with a routine group.
      description: ['Keep the trace stack ClickHouse on the 26.3 LTS line, on its own branch'],
      matchFileNames: ['apps/traces/docker-compose.yaml'],
      matchPackageNames: ['clickhouse/clickhouse-server'],
      groupName: null,
      allowedVersions: '/^26\\.3\\./',
    },
    {
      // Prometheus answers the trace stack's alert queries. It stays on the 3.13 line, the one the alert rules and the
      // scrape config were checked against; moving to the next line is an edit of this ceiling in a reviewed PR. Docker
      // Hub tags carry a `v` prefix.
      description: ['Keep the trace stack Prometheus on the 3.13 line'],
      matchFileNames: ['apps/traces/docker-compose.yaml'],
      matchPackageNames: ['prom/prometheus'],
      allowedVersions: '/^v?3\\.13\\./',
    },
    {
      // The Topics embedder serves the one model its vectors come from. Its tags are `cpu-<version>`, a prefix that the
      // docker versioning does not read, so a regex scheme names the version. It stays on the 1.9 line, the one the model
      // and the `/v1/embeddings` request shape were checked against; the next line is an edit of this ceiling in a reviewed
      // PR. The model is pinned by revision in the compose file's command and is never touched by Renovate. A new image
      // is never automerged and waits for a dashboard checkbox.
      description: ['Keep the trace stack Topics embedder on the 1.9 line, reviewed and never automerged'],
      matchFileNames: ['apps/traces/docker-compose.yaml'],
      matchPackageNames: ['ghcr.io/huggingface/text-embeddings-inference'],
      versioning: 'regex:^cpu-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
      allowedVersions: '/^cpu-1\\.9\\./',
      automerge: false,
      dependencyDashboardApproval: true,
    },
    {
      // Langfuse supports and tests Redis 7, and a Redis 7 server may not read data written by Redis 8.
      description: ['Hold the trace stack Redis at major 7'],
      matchFileNames: ['apps/traces/docker-compose.yaml'],
      matchPackageNames: ['redis'],
      allowedVersions: '<8',
    },
    {
      // The object store is pinned as `latest@sha256:<digest>`: the tag is a moving label, and the digest is
      // the pin. Only a new digest may be proposed; Renovate must never rewrite the tag to a version.
      description: ['Update the trace stack object store by digest only'],
      matchFileNames: ['apps/traces/docker-compose.yaml'],
      matchPackageNames: ['cgr.dev/chainguard/minio'],
      matchUpdateTypes: ['major', 'minor', 'patch'],
      enabled: false,
    },
    {
      // The collector is internet-facing and built from these two base images. A bump changes what ships on
      // the next deploy, so it is a reviewed PR rather than an automerge.
      description: ['Never automerge the traces collector Dockerfile base images'],
      matchFileNames: ['apps/traces/collector/Dockerfile'],
      matchManagers: ['dockerfile'],
      automerge: false,
    },
    {
      // katex is a root override that clears an advisory in the version micromark-extension-math declares
      // (^0.16). 0.18.x already has the fix; a newer minor only moves further from the declared range.
      description: ['Hold the katex override on 0.18.x'],
      matchPackageNames: ['katex'],
      allowedVersions: '<0.19',
    },
  ],
  // Track the upstream daemon source pin (`ref`) in apps/gateway/upstream.json so new
  // releases of the named `repo` surface as PRs. This is independent of the fro-bot/agent
  // GitHub Action SHA-pin in .github/workflows/ (a separate consumer Renovate already tracks).
  // depName is captured dynamically from the `repo` field.
  customManagers: [
    {
      customType: 'regex',
      // managerFilePatterns treats bare strings as globs, so the path regex is wrapped in
      // /.../ delimiters to keep regex semantics. (Renovate 40+ field; supersedes fileMatch.)
      managerFilePatterns: ['/apps/.+/upstream\\.json$/'],
      matchStrings: ['"repo":\\s*"(?<depName>[^"]+)"[^}]*"ref":\\s*"(?<currentValue>[^"]+)"'],
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver-coerced',
    },
    {
      customType: 'regex',
      // bfra-me/.github tags the same commits twice: `v4.x` for the repo and
      // `renovate-changesets@x.y.z` for the action. The built-in github-actions manager resolves
      // only the repo tags, so this pin would never move.
      // extractVersionTemplate restricts candidates to the action tag family, and capturing
      // currentDigest + currentValue together moves the SHA and its comment in one update.
      // The digest rule above is scoped to matchManagers: ['github-actions'] and does not apply.
      managerFilePatterns: ['/^\\.github/workflows/renovate-changesets\\.yaml$/'],
      matchStrings: [
        'uses:\\s*bfra-me/\\.github/\\.github/actions/renovate-changesets@(?<currentDigest>[a-f0-9]{40})\\s*#\\s*renovate-changesets@(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'bfra-me/.github',
      datasourceTemplate: 'github-tags',
      extractVersionTemplate: '^renovate-changesets@(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      // The gateway renders its Caddy service from the CADDY_IMAGE constant in deploy.ts, which
      // the docker-compose manager cannot see. Extracting it as the same docker dep (`caddy`)
      // applies the Caddy packageRule above and puts it on the same renovate/caddy-2.x branch as
      // the compose pins, so one PR moves every Caddy pin together.
      managerFilePatterns: ['/^apps/gateway/src/deploy\\.ts$/'],
      matchStrings: [
        "const CADDY_IMAGE = '(?<depName>caddy):(?<currentValue>[^@']+)@(?<currentDigest>sha256:[a-f0-9]{64})'",
      ],
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      // Every `- gomod: <module> v<semver>` line in the collector builder manifest is a Go module pin.
      // The module path is the depName and the go datasource resolves its versions, so no per-line
      // annotation is needed.
      managerFilePatterns: ['/^apps/traces/collector/builder-config\\.yaml$/'],
      matchStrings: ['-\\s+gomod:\\s+(?<depName>\\S+)\\s+(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*\\n'],
      datasourceTemplate: 'go',
    },
    {
      customType: 'regex',
      // The builder version lives in the Dockerfile and uses the `# renovate:` annotation convention
      // from apps/broker/docker-compose.yaml.
      managerFilePatterns: ['/^apps/traces/collector/Dockerfile$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\nARG OCB_VERSION=(?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
    },
  ],
  // postUpgradeTasks run after Renovate applies file changes but before the commit.
  // For github-actions manager updates (workflow SHA pins), Renovate does NOT run
  // any install step, so node_modules is empty and eslint is not available. We
  // explicitly install with --ignore-scripts (simple-git-hooks postinstall crashes
  // in the Renovate sandbox because .git/ is not present) before running the linter.
  postUpgradeTasks: {
    commands: ['bun install --ignore-scripts', 'bun run fix'],
    executionMode: 'branch',
  },
}
