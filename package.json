{
  "name": "@marcusrbrown/infra-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "deploy:broker": "bun run apps/broker/src/deploy.ts",
    "deploy:cliproxy": "bun run apps/cliproxy/src/deploy.ts",
    "deploy:dashboard": "bun run apps/dashboard/src/deploy.ts",
    "deploy:gateway": "bun run apps/gateway/src/deploy.ts",
    "deploy:umami": "bun run apps/umami/src/deploy.ts",
    "deploy:vpn": "bun run apps/vpn/src/deploy.ts",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepare": "simple-git-hooks",
    "provision:agent": "bun run apps/agent/server/provision.ts",
    "provision:broker": "bun run apps/broker/server/provision-droplet.ts",
    "provision:cliproxy": "bun run apps/cliproxy/server/provision-droplet.ts",
    "provision:dashboard": "bun run apps/dashboard/server/provision-droplet.ts",
    "provision:gateway": "bun run apps/gateway/server/provision-droplet.ts",
    "provision:umami": "bun run apps/umami/server/provision-droplet.ts",
    "provision:vpn": "bun run apps/vpn/server/provision.ts",
    "test": "bun test --recursive",
    "version-changesets": "changeset version"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,jsonc,md,yaml,yml,conf}": [
      "eslint --fix"
    ]
  },
  "prettier": "@bfra.me/prettier-config/120-proof",
  "dependencies": {
    "goke": "^6.8.0"
  },
  "devDependencies": {
    "@bfra.me/eslint-config": "0.51.4",
    "@bfra.me/prettier-config": "0.16.11",
    "@bfra.me/tsconfig": "0.13.2",
    "@changesets/cli": "3.0.1",
    "@svitejs/changesets-changelog-github-compact": "1.2.0",
    "@types/bun": "1.4.0",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "jiti": "2.7.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "simple-git-hooks": "2.13.1",
    "typescript": "6.0.3"
  },
  "patchedDependencies": {
    "@changesets/get-github-info@0.6.0": "patches/@changesets%2Fget-github-info@0.6.0.patch"
  }
}
