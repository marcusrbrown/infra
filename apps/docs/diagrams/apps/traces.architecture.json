    {"id": "canary", "from": "reporter", "to": "collector", "label": "deploy canary", "variant": "dashed"},
    {"id": "readback", "from": "reporter", "to": "tempo", "label": "deploy readback", "variant": "dashed"},
    {"id": "verdict", "from": "caddy", "to": "reporter", "label": "health path", "variant": "dashed"}
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Sender path",
      "items": [
        "Caddy routes one path per sender group and answers 404 for everything else",
        "Each group has its own token file, receiver and on-disk queues",
        "A 200 means queued, not stored by both backends"
      ]
    },
    {
      "dot": "rose",
      "title": "What each store holds",
      "items": [
        "Langfuse holds whole traces, content included",
        "Tempo holds a keep-list of attributes plus span names and error text",
        "Only Caddy is published; Langfuse and Grafana are reached over SSH"
      ]
    },
    {
      "dot": "emerald",
      "title": "Retention and opening",
      "items": [
        "30 days live and up to 8 more in volume snapshots, as targets",
        "Ingest stays off until the stores, retention and the deploy canary pass",
        "A deploy holds ingest while it changes a backend and reopens it only if the gates pass"
      ]
    }
  ]
}
