# Caddy automatically provisions and renews HTTPS certificates via Let's Encrypt.
{$DASHBOARD_DOMAIN} {
	handle /operator/* {
		reverse_proxy {$GATEWAY_VPC_IP}:9300 {
			flush_interval -1
			header_up Host dashboard.fro.bot
			header_up X-Forwarded-Proto https
		}
	}
	handle /api/* {
		reverse_proxy dashboard:3000
	}
	handle /auth/* {
		reverse_proxy dashboard:3000
	}
	@assets path_regexp \.[A-Za-z0-9]+$
	handle @assets {
		reverse_proxy dashboard:3000
	}
	handle {
		rewrite * /
		reverse_proxy dashboard:3000
	}
}
