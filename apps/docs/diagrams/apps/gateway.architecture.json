    {"id": "egress", "from": "workspace", "to": "mitm", "label": "egress", "variant": "security"},
    {"id": "allowlisted", "from": "mitm", "to": "cliproxy", "label": "allowlist", "variant": "security"},
    {"id": "catalog-egress", "from": "mitm", "to": "catalog", "label": "allowlist", "variant": "security"},
    {"id": "checkouts", "from": "workspace", "to": "repos", "label": "checkouts"},
    {"id": "ca", "from": "mitm", "to": "certs", "label": "CA"},
    {"id": "persist", "from": "gateway", "to": "state", "label": "state"}
