    {
      "dot": "cyan",
      "title": "Deploys",
      "items": [
        "Each app deploys from its own workflow behind a per-app approval gate",
        "KeeWeb deploys by rsync; the other six by SSH",
        "Gateway and dashboard images come from GHCR, pinned by digest"
      ]
    },
    {
      "dot": "rose",
      "title": "Operator path",
      "items": [
        "The browser talks only to the dashboard Caddy",
        "Caddy proxies the operator routes to the gateway over the private VPC",
        "The gateway listener is not reachable from the public edge"
      ]
    },
    {
      "dot": "emerald",
      "title": "CLIProxyAPI consumers",
      "items": [
        "Gateway workspaces and consumer workflows call the proxy with API keys",
        "Workflows can swap an OIDC token for a short-lived key at the broker",
        "The broker mints and revokes keys through the proxy management API"
      ]
    }
