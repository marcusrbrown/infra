---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import {APP_IDS} from '@marcusrbrown/infra-shared/status/history-schema'

import LastSample from '../components/LastSample.astro'
import StatusNotes from '../components/StatusNotes.astro'
import {SERVICES} from '../data/services'
import {PROOF_KINDS, PROOF_LABELS, RESULT_DISPLAY, VERDICT_DISPLAY} from '../lib/history-view'
import {loadStatusData} from '../lib/status-data'

const {source, meta, views} = loadStatusData()
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<StarlightPage
  frontmatter={{
    title: 'Status',
    description: 'Latest public observations for each monitored app, labeled by what they prove.',
    tableOfContents: false,
  }}
>
  <LastSample lastSampleAt={meta.lastSampleAt} />

  <StatusNotes fixture={source === 'fixture'} />

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">App</th>
          {PROOF_KINDS.map(kind => <th scope="col">{PROOF_LABELS[kind]}</th>)}
          <th scope="col">Summary</th>
        </tr>
      </thead>
      <tbody>
        {
          APP_IDS.map(app => {
            const view = views[app]
            const verdict = VERDICT_DISPLAY[view.verdict]
            return (
              <tr>
                <th scope="row">
                  <a href={`${base}services/${app}/`}>{SERVICES[app].title}</a>
                </th>
                {PROOF_KINDS.map(kind => {
                  const cell = view.cells[kind]
                  return (
                    <td>
                      {RESULT_DISPLAY[cell.result].symbol} {RESULT_DISPLAY[cell.result].word}
                      {cell.note !== undefined && <> ({cell.note})</>}
                    </td>
                  )
                })}
                <td>
                  {verdict.symbol} {verdict.word}: {view.verdictLabel}
                </td>
              </tr>
            )
          })
        }
      </tbody>
    </table>
  </div>

  <p>
    Legend: ✅ pass, ❌ fail, ❓ unknown (the check could not decide), ⚪ not measured (nothing in the public snapshot checks
    it). Each app's service page has its sample counts, coverage and gaps.
  </p>
</StarlightPage>

<style>
  .table-scroll {
    overflow-x: auto;
  }
</style>
