  "cards": [
    {
      "dot": "cyan",
      "title": "Sender path",
      "items": [
        "Caddy routes one path per sender group and answers 404 for everything else",
        "Each group has its own token file, receiver and on-disk queues",
        "A 200 means queued, not stored by both backends"
      ]
    },
    {
      "dot": "rose",
      "title": "What each store holds",
      "items": [
        "Langfuse holds whole traces, content included",
        "Tempo holds a keep-list of attributes plus span names and error text",
        "Only Caddy is published; the Langfuse and Grafana interfaces are reached over SSH",
        "Topics, when in use, sends capped transcripts to a zero-retention model through the operator's proxy; the embedder stays on the host",
        "Grafana alert rules post fixed text and numbers to a Discord webhook, never trace content"
      ]
    },
    {
      "dot": "orange",
      "title": "Agent read path",
      "items": [
        "Two read routes go to the reader gate, which checks a per-consumer token and adds the Viewer credentials itself",
        "Consumers never hold a Langfuse or Grafana credential, and every write is refused",
        "Reads stay up while ingest is held or off; revoking every reader token is the kill switch",
        "Langfuse reads return full trace content; Grafana queries reach Tempo and Prometheus only"
      ]
    },
    {
      "dot": "emerald",
      "title": "Retention and opening",
      "items": [
        "30 days live and up to 8 more in volume snapshots, as targets",
        "Ingest stays off until the stores, retention and the deploy canary pass",
        "A deploy holds ingest while it changes a backend and reopens it only if the gates pass"
      ]
    }
  ]
