      "size": [150, 60]
    },
    {
      "id": "oidc",
      "type": "security",
      "label": "OIDC verify",
      "sublabel": "RS256, replay denylist",
      "pos": [580, 200],
      "size": [150, 60]
    },
    {
      "id": "policy",
      "type": "security",
      "label": "Trust policy",
      "sublabel": "code-owned allowlist",
      "pos": [850, 200],
      "size": [150, 60]
    },
    {
      "id": "mint",
